{
  "name": "etch-cms",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:list": "wrangler d1 migrations list DB --remote",
    "db:query": "wrangler d1 execute DB --local --command",
    "db:query:remote": "wrangler d1 execute DB --remote --command",
    "db:export": "wrangler d1 export DB --remote --output=./prod-backup.sql",
    "db:pull": "node scripts/db-pull.mjs"
  },
  "dependencies": {
    "hono": "^4.12.7",
    "jose": "^6.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.72.0"
  }
}
