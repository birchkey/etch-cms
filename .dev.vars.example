ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2:your-salt-hex:your-hash-hex
JWT_SECRET=your-jwt-secret-hex

# Generate a password hash (writes ADMIN_PASSWORD_HASH into this file once copied to .dev.vars):
#   node scripts/hash-password.mjs yourpassword

# Generate a JWT secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
